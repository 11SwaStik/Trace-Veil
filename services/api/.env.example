# Copy this file to .env, then adjust values for your local setup.
# These variables are loaded by app/config.py via python-dotenv.

# --- App ---
ENV=local
DEBUG=true
LOG_LEVEL=INFO

# --- HTTP server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+asyncpg://traceveil:traceveil@localhost:5432/traceveil

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- JWT ---
# IMPORTANT: change this to a long random string before deploying anywhere.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=local-dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
